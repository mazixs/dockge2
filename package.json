{
    "name": "dockge2",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": "22.23.2 || 24.19.0"
    },
    "scripts": {
        "fmt": "eslint \"**/*.{ts,vue}\" --fix",
        "lint": "eslint \"**/*.{ts,vue}\"",
        "check-ts": "tsc --noEmit",
        "test:unit": "node --import tsx --test --test-concurrency=1 \"test/backend/*.test.ts\" \"test/common/*.test.ts\" \"test/frontend/*.test.ts\"",
        "test:install": "bash test/install/run.sh",
        "test:docker-integration": "cross-env DOCKGE_DOCKER_INTEGRATION=1 node --import tsx --test --test-concurrency=1 \"test/docker/*.test.ts\"",
        "coverage": "c8 npm run test:unit",
        "test": "npm run coverage",
        "check": "npm run lint && npm run check-ts && npm run test",
        "start": "tsx ./backend/index.ts",
        "dev": "concurrently -k -r \"wait-on tcp:5000 && npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cross-env NODE_ENV=development tsx watch --inspect ./backend/index.ts",
        "dev:frontend": "cross-env NODE_ENV=development vite --host --config ./frontend/vite.config.ts",
        "release-final": "tsx ./extra/test-docker.ts && tsx extra/update-version.ts && npm run build:docker",
        "release-beta": "tsx ./extra/test-docker.ts && tsx extra/update-version.ts && npm run build:docker-beta",
        "build:frontend": "vite build --config ./frontend/vite.config.ts",
        "build:docker": "node ./extra/env2arg.js docker buildx build --platform linux/amd64,linux/arm64,linux/arm/v7 -t ghcr.io/mazixs/dockge2:latest -t ghcr.io/mazixs/dockge2:2 -t ghcr.io/mazixs/dockge2:$VERSION --target release -f ./docker/Dockerfile . --push",
        "build:docker-beta": "node ./extra/env2arg.js docker buildx build --platform linux/amd64,linux/arm64,linux/arm/v7 -t ghcr.io/mazixs/dockge2:beta -t ghcr.io/mazixs/dockge2:$VERSION --target release -f ./docker/Dockerfile . --push",
        "release-nightly": "docker buildx build --platform linux/amd64,linux/arm64,linux/arm/v7 -t ghcr.io/mazixs/dockge2:nightly --target nightly -f ./docker/Dockerfile . --push",
        "start-docker": "docker run --rm -p 5001:5001 --name dockge2 ghcr.io/mazixs/dockge2:latest",
        "mark-as-nightly": "tsx ./extra/mark-as-nightly.ts",
        "reset-account": "tsx ./extra/reset-account.ts",
        "update-docker": "tsx ./extra/update-dockge.ts",
        "deploy-stack": "tsx ./extra/deploy-stack.ts",
        "test:e2e": "playwright test",
        "test:visual": "playwright test --config playwright-visual.config.ts",
        "test:visual:approve": "playwright test --config playwright-visual.config.ts --update-snapshots=changed"
    },
    "dependencies": {
        "@homebridge/node-pty-prebuilt-multiarch": "0.14.1",
        "@inventage/envsubst": "0.17.0",
        "@modelcontextprotocol/sdk": "1.30.0",
        "better-auth": "1.7.2",
        "better-sqlite3": "13.0.3",
        "compare-versions": "~6.1.1",
        "composerize": "1.7.6",
        "croner": "10.0.1",
        "dayjs": "1.11.23",
        "dotenv": "17.4.2",
        "express": "4.22.3",
        "express-static-gzip": "3.0.1",
        "http-graceful-shutdown": "4.0.0",
        "knex": "3.3.0",
        "semver": "7.8.5",
        "socket.io": "4.8.3",
        "socket.io-client": "4.8.3",
        "ts-command-line-args": "2.5.1",
        "tsx": "4.23.12",
        "type-fest": "5.8.0",
        "yaml": "2.9.0",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@actions/github": "9.1.1",
        "@codemirror/lang-python": "6.2.1",
        "@codemirror/lang-yaml": "6.1.3",
        "@codemirror/theme-one-dark": "6.1.3",
        "@eslint/js": "10.0.1",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@fontsource/jetbrains-mono": "5.3.0",
        "@fortawesome/fontawesome-svg-core": "7.3.1",
        "@fortawesome/free-regular-svg-icons": "7.3.1",
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "@fortawesome/vue-fontawesome": "3.3.3",
        "@playwright/test": "1.62.1",
        "@types/better-sqlite3": "9.6.0",
        "@types/bootstrap": "5.2.11",
        "@types/express": "4.17.25",
        "@types/node": "24.13.3",
        "@types/semver": "7.8.0",
        "@typescript-eslint/eslint-plugin": "8.68.0",
        "@typescript-eslint/parser": "8.68.0",
        "@vitejs/plugin-vue": "6.0.8",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/xterm": "6.0.0",
        "bootstrap": "5.3.8",
        "bootstrap-vue-next": "1.0.1",
        "c8": "12.0.0",
        "codemirror": "6.0.2",
        "concurrently": "10.0.5",
        "cross-env": "10.1.0",
        "eslint": "10.9.1",
        "eslint-plugin-jsdoc": "64.2.1",
        "eslint-plugin-vue": "10.10.0",
        "globals": "17.11.0",
        "qrcode": "1.5.4",
        "sass": "1.103.1",
        "typescript": "5.9.3",
        "unplugin-vue-components": "32.1.0",
        "vite": "8.2.2",
        "vite-plugin-compression2": "2.5.3",
        "vue": "3.5.41",
        "vue-codemirror6": "1.6.1",
        "vue-eslint-parser": "10.4.1",
        "vue-i18n": "11.4.10",
        "vue-qrcode": "2.2.2",
        "vue-router": "4.5.1",
        "vue3-toastify": "0.2.9",
        "wait-on": "9.1.0"
    },
    "overrides": {
        "better-auth": {
            "better-sqlite3": "13.0.3"
        }
    }
}
