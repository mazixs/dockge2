{
    "all": true,
    "include": [
        "backend/**/*.ts",
        "common/**/*.ts",
        "frontend/src/**/*.ts",
        "extra/deploy-stack.ts",
        "extra/check-coverage.ts",
        "extra/check-bundle.ts"
    ],
    "exclude": [
        "backend/index.ts",
        "backend/migrations/**",
        "**/*.d.ts",
        "common/types/**",
        "frontend/src/root-api.ts",
        "frontend/src/main.ts",
        "frontend/src/root.ts",
        "frontend/src/router.ts",
        "frontend/src/icon.ts",
        "frontend/src/auth-client.ts",
        "frontend/src/directives/**",
        "frontend/src/mixins/**"
    ],
    "excludeAfterRemap": true,
    "checkCoverage": true,
    "lines": 70,
    "statements": 70,
    "functions": 70,
    "branches": 70,
    "reporter": [
        "text",
        "text-summary",
        "lcov"
    ]
}
