# Everything .gitignore keeps out of the repository is kept out of the build
# context too, and this file adds what only the image has no use for. A path
# that is missing here does reach the image: the release stage copies the whole
# context, so a TLS key left next to the compose file would be baked into a
# layer.
.env
.env.local
.tmp/
node_modules
frontend-dist
.idea
data
stacks
tmp

# Private to whoever deployed the panel: the TLS files DOCKGE_SSL_* points at,
# their own compose overrides and the assistant's local settings
certs
docker-compose.override.yml
.claude

# Local review artefacts and the leftovers of an interrupted type check
output

# A local `go build` of the updater; the release builds its own
extra/updater/updater

# Docker extra
docker
docker-compose.local.yml
local.sh
.env.example
coverage
.editorconfig
.git
.gitignore
README.md
test-results
playwright-report
blob-report
.vscode
.DS_Store
*.log
*.tsbuildinfo

# Never in the image: the review stand and the tests. extra/seed-review.ts
# starts a panel with authentication switched off, so it belongs in the
# repository and nowhere near a host
docs
test
extra/seed-review.ts
extra/performance-*
playwright.config.ts
playwright-visual.config.ts
.github
AGENTS.md
CLAUDE.md

# Private, versioned deployment state and stopped-data snapshots
.dockge2/
*.dockge-failed-*
*.dockge-restore-*

# Local browser sessions and environment variants must not be published.
.playwright-cli/
.env.*
