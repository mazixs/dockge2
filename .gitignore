# .dockerignore is wider than this file: the image also leaves out the tests,
# the documentation and the review stand. Check it when changing anything here
.env
.env.local
.tmp/
node_modules
.idea
data
stacks
tmp

# Git only
frontend-dist
coverage

# Local review artefacts: screenshots, probes and their notes
/output/

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Session of the e2e run
test/e2e/.auth

# Editors and OS
.vscode
.DS_Store
Thumbs.db
*~
*.swp

# Appears on a machine where the panel was deployed as the README describes
certs
docker-compose.override.yml

# Local artifacts
*.log
# `go build` in extra/updater; releases build the binaries in CI
/extra/updater/updater
npm-debug.log*
*.tsbuildinfo
.eslintcache
.vite
.claude/settings.local.json


# Private, versioned deployment state and stopped-data snapshots
.dockge2/
*.dockge-failed-*
*.dockge-restore-*

# Local browser sessions and environment variants must not be published.
.playwright-cli/
.env.*
!.env.example
