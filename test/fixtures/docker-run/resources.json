{
    "description": "Memory, CPU, process and file limits and a GPU count with extra capabilities survive. The memory reservation goes under deploy, where compose accepts it next to the GPU reservation, and a swap limit of -1 stays a string.",
    "command": "docker run -d --memory 512m --memory-reservation 256m --memory-swap -1 --cpus 1.5 --pids-limit 100 --shm-size 256m --ulimit nofile=1024:2048 --ulimit nproc=512 --gpus 'count=1,\"capabilities=compute,utility\"' nvidia/cuda:12.4.1-base-ubuntu22.04",
    "verdict": "kept",
    "compose": {
        "topLevel": [
            "services"
        ],
        "service": "cuda",
        "keys": [
            "image",
            "mem_limit",
            "deploy",
            "memswap_limit",
            "cpus",
            "pids_limit",
            "shm_size",
            "ulimits"
        ],
        "values": {
            "image": "nvidia/cuda:12.4.1-base-ubuntu22.04",
            "mem_limit": "512m",
            "deploy": {
                "resources": {
                    "reservations": {
                        "memory": "256m",
                        "devices": [
                            {
                                "driver": "nvidia",
                                "count": 1,
                                "capabilities": [
                                    "compute",
                                    "utility",
                                    "gpu"
                                ]
                            }
                        ]
                    }
                }
            },
            "memswap_limit": "-1",
            "cpus": 1.5,
            "pids_limit": 100,
            "shm_size": "256m",
            "ulimits": {
                "nofile": {
                    "soft": 1024,
                    "hard": 2048
                },
                "nproc": 512
            }
        }
    },
    "report": {
        "carried": [
            "-d",
            "--memory",
            "--memory-reservation",
            "--memory-swap",
            "--cpus",
            "--pids-limit",
            "--shm-size",
            "--ulimit",
            "--ulimit",
            "--gpus"
        ],
        "review": [],
        "dropped": []
    },
    "composeConfig": {
        "valid": true
    }
}
