{
    "description": "docker run gets a single-quoted value as it is, compose reads every $ in it as a variable. The value is left as written, since a $ may be meant as a variable, and the report asks for a look: here a password hash is cut short with only a warning from compose.",
    "command": "docker run -d -e 'ADMIN_HASH=$2y$10$abcdefghijk' traefik/whoami",
    "verdict": "warned",
    "compose": {
        "topLevel": [
            "services"
        ],
        "service": "whoami",
        "keys": [
            "image",
            "environment"
        ],
        "values": {
            "image": "traefik/whoami",
            "environment": [
                "ADMIN_HASH=$2y$10$abcdefghijk"
            ]
        }
    },
    "report": {
        "carried": [
            "-d"
        ],
        "review": [
            {
                "flag": "-e",
                "reason": "flagDollarInterpolated"
            }
        ],
        "dropped": []
    },
    "composeConfig": {
        "valid": true,
        "stderr": "abcdefghijk\\W{1,3}variable is not set"
    }
}
