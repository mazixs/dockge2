                "reason": "flagNotAccepted"
            },
            {
                "flag": "--health-retries",
                "reason": "flagNotAccepted"
            },
            {
                "flag": "--log-opt",
                "reason": "flagNotAccepted"
            },
            {
                "flag": "--stop-timeout",
                "reason": "flagNotAccepted"
            },
            {
                "flag": "--mount",
                "reason": "flagNotAccepted"
            },
            {
                "flag": "--mount",
                "reason": "flagNotAccepted"
            },
            {
                "flag": "--gpus",
                "reason": "flagGpusDropped"
            },
            {
                "flag": "--network",
                "reason": "flagNotAccepted"
            }
        ]
    },
    "composeConfig": {
        "valid": true
    }
