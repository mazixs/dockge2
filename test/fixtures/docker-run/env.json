        "values": {
            "image": "nginx",
            "environment": [
                "TZ=Europe/Amsterdam",
                "GREETING=hello world",
                "EMPTY=",
                "PASSTHROUGH"
            ]
        }
    },
    "report": {
        "carried": [
            "-d",
            "-e",
            "-e",
            "--env",
            "-e"
        ],
