{
    "description": "A device selection becomes a reservation of exactly those devices, with the gpu capability docker always asks for. The device ids stay strings.",
    "command": "docker run -d --gpus '\"device=0,1\"' nvidia/cuda:12.4.1-base-ubuntu22.04",
    "verdict": "kept",
