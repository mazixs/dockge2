# Environment of dockge2. Copy it to .env and adjust: cp .env.example .env
# docker compose reads .env for both the production and the local configuration;
# .env.local is passed explicitly by local.sh only. Neither file is committed.
# A release installation keeps its own .env in the installation directory,
# see docs/configuration.md.

########################################
# The panel (both configurations)
########################################

# Port of the panel, published on the host under the same number.
DOCKGE_PORT=5001

# Address the backend listens on. Empty means all interfaces.
DOCKGE_HOSTNAME=

# SQLite database and settings.
# In production this is the host path; inside the container it is always /app/data.
DOCKGE_DATA_DIR=./data

# Stacks directory for production.
# Absolute path only: it is mounted at the same path, because the Docker daemon
# on the host runs the compose commands and resolves their paths.
DOCKGE_STACKS_DIR=/opt/stacks

# Owner of the stack files the panel creates. Set both or neither,
# otherwise the files belong to root. local.sh fills them in for development.
PUID=
PGID=

# Web console with a shell in the panel container, for owners and operators.
# The container holds the Docker socket, so keep it off in production.
DOCKGE_ENABLE_CONSOLE=false

########################################
# Access and HTTPS
########################################

# Behind a reverse proxy set both: the first trusts X-Forwarded-*,
# the second marks the session cookie Secure.
DOCKGE_TRUST_PROXY=
DOCKGE_SECURE_COOKIES=

# Public origin without a path. HTTPS switches Secure cookies on by itself.
DOCKGE_PUBLIC_URL=

# Optional one-use setup code, at least 32 characters.
# Empty: the code is generated into data/bootstrap-token with permissions 0600.
DOCKGE_BOOTSTRAP_TOKEN=

# Extra browser origins, comma separated, when the UI is served from another address.
DOCKGE_TRUSTED_ORIGINS=

# Signs session cookies. Empty: generated on first start and kept in the database.
# Set it only when several instances have to share one secret.
DOCKGE_AUTH_SECRET=

# Optional signed cross-server MCP channel, a file inside the container,
# for example /app/data/mcp-delegation.json with permissions 0600. Empty turns it off.
# Keep the file in the data directory, not in Git. The format is in docs/mcp.md.
DOCKGE_MCP_DELEGATION_CONFIG=

# HTTPS without a reverse proxy: paths inside the container to mounted files,
# see the commented certs volume in docker-compose.yml.
DOCKGE_SSL_KEY=
DOCKGE_SSL_CERT=
DOCKGE_SSL_KEY_PASSPHRASE=

########################################
# Diagnostics (rarely needed)
########################################

# Log categories to hide, comma separated: DOCKGE_HIDE_LOG=debug_monitor,info_monitor
DOCKGE_HIDE_LOG=

# bypass switches the WebSocket origin check off. Leave it empty:
# the check stops other websites from connecting to the panel.
DOCKGE_WS_ORIGIN_CHECK=

########################################
# Production only (docker-compose.yml)
########################################

# Image to run. The published image is pulled ready-made: building the frontend
# needs about 1 GB of memory, running the panel about 200 MB.
# Release updates keep the selected source in .dockge2/active.json;
# change it explicitly with --image. A local name never implies a build fallback.
DOCKGE_IMAGE=ghcr.io/mazixs/dockge2:latest

########################################
# Local development only (docker-compose.local.yml)
########################################

# Stacks directory for development, a separate variable so that a local run
# never picks up the production DOCKGE_STACKS_DIR or needs root.
# Absolute, for the same reason as in production.
DOCKGE_LOCAL_STACKS_DIR=/tmp/dockge2-stacks

# Separate local database, /app/data inside the container.
DOCKGE_LOCAL_DATA_DIR=./data

# On macOS and Windows file changes through a bind mount do not reach the watcher;
# set it to true there. Not needed on Linux.
CHOKIDAR_USEPOLLING=
