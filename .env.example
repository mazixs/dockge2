# Пример переменных окружения dockge2.
# Скопируйте в .env и правьте под себя: cp .env.example .env
# .env читает docker compose (и production, и локальная конфигурация),
# .env.local подключает только local.sh - он передает файл явно.
# Ни один из этих файлов в репозиторий не попадает.

########################################
# Приложение (используются обеими конфигурациями)
########################################

# Порт панели. В production он же пробрасывается на хост.
DOCKGE_PORT=5001

# Адрес, на котором слушает бэкенд. Пусто - все интерфейсы.
DOCKGE_HOSTNAME=

# Каталог с SQLite-базой и настройками.
# В production это путь на хосте, внутри контейнера он всегда /app/data.
DOCKGE_DATA_DIR=./data

# Каталог стеков для production.
# Только абсолютный путь: он монтируется в контейнер один в один, потому что
# команды docker compose выполняет демон на хосте.
DOCKGE_STACKS_DIR=/opt/stacks

# Владелец файлов стеков, которые создает панель. Нужны обе переменные сразу,
# иначе файлы останутся за root. Локально их подставляет local.sh.
PUID=
PGID=

# Веб-консоль хоста. true дает shell владельцам и операторам,
# поэтому в production держим выключенной.
DOCKGE_ENABLE_CONSOLE=false

########################################
# Доступ и HTTPS
########################################

# За обратным прокси нужны обе: первая заставляет верить X-Forwarded-*,
# вторая помечает cookie сессии как Secure.
DOCKGE_TRUST_PROXY=
DOCKGE_SECURE_COOKIES=

# Публичный адрес без пути. HTTPS автоматически включает Secure cookie.
DOCKGE_PUBLIC_URL=

# Необязательный одноразовый код настройки, не менее 32 символов.
# Пусто - код создается в data/bootstrap-token с правами 0600.
DOCKGE_BOOTSTRAP_TOKEN=

# Дополнительные origin через запятую, если интерфейс отдается с другого адреса.
DOCKGE_TRUSTED_ORIGINS=

# Секрет подписи сессий. Пусто - генерируется при первом старте и лежит в базе.
# Задавайте, только если секрет должен быть общим для нескольких экземпляров.
DOCKGE_AUTH_SECRET=

# Необязательный файл подписанного межсерверного канала MCP внутри контейнера.
# Например /app/data/mcp-delegation.json, права 0600. Пусто - канал выключен.
# Файл храните в каталоге данных, не в Git. Формат описан в docs/mcp.md.
DOCKGE_MCP_DELEGATION_CONFIG=

# HTTPS без обратного прокси: пути к файлам внутри контейнера,
# сами файлы нужно примонтировать (см. закомментированный том в docker-compose.yml).
DOCKGE_SSL_KEY=
DOCKGE_SSL_CERT=
DOCKGE_SSL_KEY_PASSPHRASE=

########################################
# Диагностика (обычно не нужны)
########################################

# Скрыть категории логов, через запятую: DOCKGE_HIDE_LOG=debug_monitor,info_monitor
DOCKGE_HIDE_LOG=

# bypass отключает проверку origin у websocket. Оставляйте пустым:
# это защита от подключения со стороннего сайта.
DOCKGE_WS_ORIGIN_CHECK=

########################################
# Только production (docker-compose.yml)
########################################

# Образ, который запускается. Имя с реестром - ghcr.io/mazixs/dockge2:latest -
# скачивается готовым: сборка фронтенда просит около 1 ГБ памяти, а запуск
# панели около 170 МБ, и на маленьком сервере это решающая разница.
# Release updates preserve the selected source in .dockge2/active.json.
# Change it explicitly with --image; a local name never implies a build fallback.
DOCKGE_IMAGE=ghcr.io/mazixs/dockge2:latest

########################################
# Только локальная разработка (docker-compose.local.yml)
########################################

# Каталог стеков для разработки. Отдельная переменная, чтобы локальный запуск
# не подхватил боевой DOCKGE_STACKS_DIR и не потребовал root.
# Путь должен быть абсолютным по той же причине, что и в production.
DOCKGE_LOCAL_STACKS_DIR=/tmp/dockge2-stacks

# Отдельный каталог локальной базы, внутри контейнера /app/data.
DOCKGE_LOCAL_DATA_DIR=./data

# На macOS и Windows изменения файлов через bind mount не долетают до watcher,
# тогда поставьте true. На Linux не нужно.
CHOKIDAR_USEPOLLING=
